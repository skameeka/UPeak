PORT=3000

# Apps Script деплой ПЛАНИРОВЩИКА (страница /planner.html, таблица PlannerEvents)
PLANNER_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_PLANNER_DEPLOYMENT_ID/exec
PLANNER_APPS_SCRIPT_TOKEN=replace_with_planner_shared_token

# Apps Script деплой РЕГИСТРАЦИИ (страница /participate.html, таблица Participants)
REGISTRATION_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_REGISTRATION_DEPLOYMENT_ID/exec
REGISTRATION_APPS_SCRIPT_TOKEN=replace_with_registration_shared_token

# Обратная совместимость: если PLANNER_APPS_SCRIPT_URL не задан, используется APPS_SCRIPT_URL.
# APPS_SCRIPT_URL=
# APPS_SCRIPT_SHARED_TOKEN=
